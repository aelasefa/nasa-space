{
  "name": "nasa-space",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:domain": "tsc -p tsconfig.domain.json && node -e \"require('node:fs').writeFileSync('dist-domain/package.json', JSON.stringify({type: 'commonjs'}))\"",
    "test:domain": "npm run build:domain && node --test dist-domain/tests/domain/*.test.js"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.180.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "4.1.12",
    "@types/node": "^24.19.2",
    "oxlint": "^1.90.0"
  }
}
