{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Bundler",
    "outDir": "dist-domain",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "src/server.ts",
    "src/domain/**/*.ts",
    "src/data/**/*.ts",
    "src/multiplayer/**/*.ts",
    "tests/domain/**/*.ts",
    "tests/multiplayer/**/*.ts"
  ]
}
